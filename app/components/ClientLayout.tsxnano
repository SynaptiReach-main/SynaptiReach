"use client"

import Link from "next/link"
import { useState, useEffect, useRef } from "react"
import { GradientText } from "./ui"

export default function ClientLayout({ children }) {
  const [open, setOpen] = useState(false)
  const sidebarRef = useRef<HTMLDivElement | null>(null)

  useEffect(() => {
    function handleClickOutside(e: MouseEvent) {
      if (open && sidebarRef.current && !sidebarRef.current.contains(e.target as Node)) {
        setOpen(false)
      }
    }

    document.addEventListener("mousedown", handleClickOutside)
    return () => document.removeEventListener("mousedown", handleClickOutside)
  }, [open])

  return (
    <div className="min-h-screen text-white bg-[#0A0F1F] relative overflow-hidden">

      {/* NEW LAYER 1: Radial deep teal bleed originating from the bottom-left */}
      <div className="absolute bottom-0 left-0 w-[100vw] h-[60vh] bg-gradient-to-t from-[#0D2A1F]/35 via-transparent to-transparent pointer-events-none z-0" />

      {/* NEW LAYER 2: Highly visible cross-dot matrix neural pattern */}
      <div
        className="absolute inset-0 z-0 pointer-events-none opacity-[0.12] md:opacity-[0.15]"
        style={{
          backgroundImage: `
            radial-gradient(rgba(0, 229, 255, 0.4) 1.5px, transparent 1.5px),
            linear-gradient(to right, rgba(0, 229, 255, 0.08) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(0, 229, 255, 0.08) 1px, transparent 1px)
          `,
          backgroundSize: '40px 40px, 40px 40px, 40px 40px',
          backgroundPosition: '0 0, 0 0, 0 0'
        }}
      />

      {/* 🔥 ULTRA-SMOOTH WAVE GLOW (Kept exactly as it was) */}
      <div
        className="absolute top-[-10%] left-[-20%] w-[140vw] md:w-[120vw] h-[500px] md:h-[800px] bg-gradient-to-br from-cyan-400/50 via-cyan-500/20 to-transparent pointer-events-none z-0 blur-[120px] md:blur-[160px]"
        style={{
          borderRadius: "60% 40% 70% 30% / 50% 60% 40% 50%",
          animation: "waveDrift 18s ease-in-out infinite alternate"
        }}
      />

      {/* BACKDROP */}
      {open && (
        <div
          className="fixed inset-0 bg-black/40 backdrop-blur-sm z-40"
          onClick={() => setOpen(false)}
        />
      )}

      {/* NAVBAR */}
      <header className="flex items-center justify-between px-4 md:px-8 h-20 md:h-28 border-b border-gray-800 relative z-20 bg-[#0A0F1F]/40 backdrop-blur-sm">

        <div className="flex items-center">

          <button
            onClick={() => setOpen(prev => !prev)}
            className="text-cyan-400 text-xl cursor-pointer mr-3"
          >
            ☰
          </button>

          <Link href="/" className="flex items-center">
            <img
              src="/logo.png"
              className="w-20 h-20 md:w-28 md:h-28 object-contain"
              alt="logo"
            />
            <GradientText className="text-base md:text-2xl font-extrabold -ml-4 md:-ml-8">
              SynaptiReach
            </GradientText>
          </Link>

        </div>

        <div className="flex items-center gap-3">
          <Link href="/signin" className="text-sm text-gray-300 hover:text-white transition">
            Sign In
          </Link>

          <Link href="/signup" className="px-4 py-2 text-sm font-semibold rounded-full bg-gradient-to-r from-cyan-400 to-green-400 text-black hover:opacity-90 transition">
            Sign Up
          </Link>
        </div>

      </header>

      {/* SIDEBAR */}
      <aside
        ref={sidebarRef}
        className={`
          fixed top-0 left-0 h-screen w-64 md:w-72 bg-[#0D1B2A]
          border-r border-cyan-500/10 z-50
          transform ${open ? "translate-x-0" : "-translate-x-full"}
          transition-transform duration-300 ease-in-out
          shadow-2xl
        `}
      >

        <div className="p-6 space-y-6">

          <Link href="/" onClick={() => setOpen(false)} className="flex items-center">
            <img src="/logo.png" className="w-20 h-20 object-contain" alt="logo" />
            <GradientText className="text-lg font-extrabold -ml-4">
              SynaptiReach
            </GradientText>
          </Link>

          <nav className="space-y-4 mt-6">
            <Link href="/" onClick={() => setOpen(false)} className="block text-cyan-300 hover:text-white">Home</Link>
            <Link href="/pricing" onClick={() => setOpen(false)} className="block text-cyan-300 hover:text-white">Pricing</Link>
            <Link href="/services" onClick={() => setOpen(false)} className="block text-cyan-300 hover:text-white">Services</Link>
            <Link href="/trial" onClick={() => setOpen(false)} className="block text-cyan-300 hover:text-white">Trial</Link>
            <Link href="/guide" onClick={() => setOpen(false)} className="block text-cyan-300 hover:text-white">Start-up guide</Link>
          </nav>

        </div>

      </aside>

      {/* MAIN */}
      <main className="relative z-10 px-4 md:px-10 py-6">
        {children}
      </main>

      {/* ANIMATION */}
      <style jsx global>{`
        @keyframes waveDrift {
          0% {
            transform: rotate(-15deg) translate(-2vw, -2vh) scale(1);
          }
          50% {
            transform: rotate(-10deg) translate(2vw, 3vh) scale(1.05);
          }
          100% {
            transform: rotate(-15deg) translate(-2vw, -2vh) scale(1);
          }
        }
      `}</style>

    </div>
  )
}

