NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers are server-side only. Do not create NEXT_PUBLIC_* AI keys.
# Recommended low-cost daily CRM AI provider:
GEMINI_API_KEY=

# Optional fallback provider for free/low-cost routed models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional high-quality provider. Disabled unless AI_ENABLE_OPENAI=true.
AI_ENABLE_OPENAI=false
OPENAI_API_KEY=

# Optional model overrides
AI_PROVIDER_ORDER=gemini,openrouter
GEMINI_CHEAP_MODEL=gemini-1.5-flash-8b
GEMINI_BALANCED_MODEL=gemini-1.5-flash
OPENAI_BALANCED_MODEL=gpt-4o-mini
OPENAI_PREMIUM_MODEL=gpt-4o
OPENROUTER_SECONDARY_MODEL=openrouter/free

# Local development AI. Server-side names are preferred for this Next.js app.
AI_DEFAULT_PROVIDER=ollama-dev
AI_ENABLE_LOCAL=true
AI_ENABLE_OLLAMA_DEV=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Backward-compatible aliases for earlier local setup.
VITE_AI_DEFAULT_PROVIDER=ollama-dev
VITE_AI_ENABLE_LOCAL=true
VITE_AI_ENABLE_OLLAMA_DEV=true
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=gemma3:1b

RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AYRSHARE_API_KEY=

# Stripe billing keys. Publishable key is client-safe; secret/webhook keys are server-side only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC_BYOK=
STRIPE_PRICE_GROWTH_BYOK=
STRIPE_PRICE_PREMIUM_BYOK=
STRIPE_PRICE_BASIC_MANAGED=
STRIPE_PRICE_GROWTH_MANAGED=
STRIPE_PRICE_PREMIUM_MANAGED=

# Test-only simulated workspace. Never enable for normal production users.
CRM_ENABLE_TEST_SIMULATION=false
CRM_TEST_ACCOUNT_EMAILS=donovan.mike966@gmail.com
CRM_TEST_WORKSPACE_IDS=
CRM_TEST_BOOTSTRAP_SECRET=
CRM_TEST_SIMULATION_SEED_SECRET=

# Admin record viewing/actions are disabled by default until final admin auth is configured.
CRM_ADMIN_READ_ENABLED=false
CRM_ADMIN_ACTION_SECRET=

# Optional email sender config. Rotate RESEND_API_KEY after any shared-chat testing.
RESEND_FROM_EMAIL=
SYNAPTIREACH_CONTACT_EMAIL=
