NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers are server-side only. Do not create NEXT_PUBLIC_* AI keys.
# Recommended low-cost daily CRM AI provider:
GEMINI_API_KEY=

# Optional fallback provider for free/low-cost routed models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional high-quality provider. Disabled unless AI_ENABLE_OPENAI=true.
AI_ENABLE_OPENAI=false
OPENAI_API_KEY=

# Optional model overrides
AI_PROVIDER_ORDER=gemini,openrouter
GEMINI_CHEAP_MODEL=gemini-1.5-flash-8b
GEMINI_BALANCED_MODEL=gemini-1.5-flash
OPENAI_BALANCED_MODEL=gpt-4o-mini
OPENAI_PREMIUM_MODEL=gpt-4o
OPENROUTER_SECONDARY_MODEL=openrouter/free

RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AYRSHARE_API_KEY=
